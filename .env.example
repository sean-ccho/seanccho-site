# 대시보드 데이터 주소 (비워 두면 기본값: sean-ccho/Project_1 의 dashboard-data 브랜치)
# DASHBOARD_URL=https://raw.githubusercontent.com/sean-ccho/Project_1/dashboard-data/dashboard.json

# 로컬 개발용 — 파일에서 바로 읽기 (Project_1 에서 python -m web_export.dashboard 로 만든 파일)
# DASHBOARD_FILE=./dev-data/dashboard.json

# /api/revalidate 키 (Project_1 CI 가 실행 끝에 부른다 — GitHub Secret 과 같은 값)
# REVALIDATE_SECRET=

# 내계좌(/quant/account) 비밀번호 — 없으면 내계좌는 열리지 않는다 (아이디는 아무거나)
# SITE_PASSWORD=

# 내계좌 구글 시트 읽기·쓰기 — 서비스 계정 JSON 전체를 한 줄로
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SHEETS_SPREADSHEET_ID=
